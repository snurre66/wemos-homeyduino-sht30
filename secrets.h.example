#pragma once

// WiFi network credentials
#define SECRET_SSID "Your_WiFi_SSID"
#define SECRET_PASS "Your_WiFi_Password"

/**
 * Optional: Default Device Name (used if no custom name is stored in EEPROM).
 * 
 * ⚠️ mDNS / Hostname Rules:
 * - Standard network/mDNS allows ONLY alphanumeric characters (A-Z, a-z, 0-9) and hyphens (-).
 * - Underscores (_) and spaces are forbidden in mDNS/DNS hostnames and will cause .local lookup failures in browsers.
 * - The firmware automatically sanitizes underscores (_), spaces, dots, and slashes into hyphens (-).
 * 
 * Examples: "WineCellar", "WineCabinet-SHT30", "WineFridge", "StorageRoom"
 */
#define DEVICE_NAME "WineCabinet-SHT30"

// Optional: OTA update password (comment out if no password is needed)
#define OTA_PASSWORD "1234"


